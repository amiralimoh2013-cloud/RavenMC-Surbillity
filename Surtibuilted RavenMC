/* =========================================================
   انیمیشن مقدمه — ۲۰ ثانیه
========================================================= */
(() => {
  const canvas = document.getElementById('intro');
  const ctx = canvas.getContext('2d');
  const skipBtn = document.getElementById('skip');

  const T_CONV_START = 4.5;
  const T_CONV_END   = 13.0;
  const T_FADE_START = 18.2;
  const T_FADE_END   = 19.6;
  const T_TOTAL      = 20.0;

  const smoothstep = (a,b,x) => {
    const t = Math.min(1, Math.max(0,(x-a)/(b-a)));
    return t*t*(3-2*t);
  };
  const rand = (a,b) => a + Math.random()*(b-a);

  let W=0,H=0,DPR=1;
  const rect = {w:0,h:0,r:0,cx:0,cy:0};
  const N = window.innerWidth < 700 ? 92 : 148;
  const P = [];
  let running = true, finished = false;
  let startT = performance.now();

  function computeRect(){
    rect.w = Math.min(W*0.88, 1060);
    rect.h = Math.min(H*0.74, 640);
    rect.r = Math.min(84, rect.h*0.24);
    rect.cx = W/2; rect.cy = H/2;
  }

  function pointAt(u){
    u = ((u%1)+1)%1;
    const w=rect.w,h=rect.h,R=rect.r;
    const x0=rect.cx-w/2, y0=rect.cy-h/2;
    const top=w-2*R, side=h-2*R, arc=Math.PI*R/2;
    const total = 2*top + 2*side + 4*arc;
    let d = u*total;
    if(d<top) return {x:x0+R+d, y:y0};
    d-=top;
    if(d<arc){const a=-Math.PI/2+(d/arc)*(Math.PI/2);
      return {x:x0+w-R+R*Math.cos(a), y:y0+R+R*Math.sin(a)};}
    d-=arc;
    if(d<side) return {x:x0+w, y:y0+R+d};
    d-=side;
    if(d<arc){const a=(d/arc)*(Math.PI/2);
      return {x:x0+w-R+R*Math.cos(a), y:y0+h-R+R*Math.sin(a)};}
    d-=arc;
    if(d<top) return {x:x0+w-R-d, y:y0+h};
    d-=top;
    if(d<arc){const a=Math.PI/2+(d/arc)*(Math.PI/2);
      return {x:x0+R+R*Math.cos(a), y:y0+h-R+R*Math.sin(a)};}
    d-=arc;
    if(d<side) return {x:x0, y:y0+h-R-d};
    d-=side;
    const a = Math.PI+(d/arc)*(Math.PI/2);
    return {x:x0+R+R*Math.cos(a), y:y0+R+R*Math.sin(a)};
  }

  function assignTargets(){
    for(let i=0;i<N;i++){
      const p = pointAt(i/N);
      P[i].tx = p.x; P[i].ty = p.y;
    }
  }

  function resize(){
    DPR = Math.min(window.devicePixelRatio||1, 2);
    W = window.innerWidth; H = window.innerHeight;
    canvas.width = Math.floor(W*DPR);
    canvas.height = Math.floor(H*DPR);
    ctx.setTransform(DPR,0,0,DPR,0,0);
    computeRect(); assignTargets();
  }

  for(let i=0;i<N;i++){
    P.push({
      fx: Math.random()*window.innerWidth,
      fy: Math.random()*window.innerHeight,
      vx: rand(-0.38,0.38),
      vy: rand(-0.38,0.38),
      x:0,y:0,tx:0,ty:0,
      size: rand(1.1,2.5),
      pulse: Math.random()*Math.PI*2,
      hue: Math.random()<0.18 ? 265 : 198 + rand(-14,20)
    });
  }
  resize();
  window.addEventListener('resize', resize);
  for(const p of P){ p.x = p.fx; p.y = p.fy; }

  const pulses = [
    {u:0.00, speed: 0.048, hue:198, len:0.030},
    {u:0.42, speed:-0.036, hue:268, len:0.024},
    {u:0.73, speed: 0.062, hue:170, len:0.020}
  ];

  function finishIntro(){
    if(finished) return;
    finished = true; running = false;
    canvas.style.transition = 'opacity .7s';
    canvas.style.opacity = '0';
    skipBtn.classList.remove('on');
    setTimeout(()=>{ canvas.style.display='none'; }, 750);
    document.getElementById('app').classList.add('show');
    startHeaderAnim();
  }

  function frame(now){
    if(!running) return;
    const t = (now - startT)/1000;

    if(t > 2.2) skipBtn.classList.add('on');

    const fadeIn  = smoothstep(0,0.9,t);
    const fadeOut = 1 - smoothstep(T_FADE_START, T_FADE_END, t);
    const alpha   = fadeIn*fadeOut;
    const k       = smoothstep(T_CONV_START, T_CONV_END, t);
    const glow    = smoothstep(T_CONV_END, T_CONV_END+2.5, t);

    ctx.clearRect(0,0,W,H);
    ctx.globalAlpha = alpha;

    for(const p of P){
      p.fx += p.vx; p.fy += p.vy;
      if(p.fx<0||p.fx>W){ p.vx*=-1; p.fx=Math.max(0,Math.min(W,p.fx)); }
      if(p.fy<0||p.fy>H){ p.vy*=-1; p.fy=Math.max(0,Math.min(H,p.fy)); }
      p.x = p.fx + (p.tx-p.fx)*k;
      p.y = p.fy + (p.ty-p.fy)*k;
    }

    const maxD = 132 - 62*k;
    const maxD2 = maxD*maxD;
    ctx.lineWidth = 0.65 + k*0.55;

    for(let i=0;i<N;i++){
      const a = P[i];
      for(let j=i+1;j<N;j++){
        const b = P[j];
        const dx=a.x-b.x, dy=a.y-b.y;
        const d2 = dx*dx+dy*dy;
        if(d2>maxD2) continue;
        const d = Math.sqrt(d2);
        let al = Math.pow(1-d/maxD,1.7)*0.55*(0.55+0.45*k);
        if(al<0.012) continue;
        ctx.strokeStyle = `rgba(96,190,255,${al})`;
        ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
      }
    }

    if(k>0.02 && ctx.roundRect){
      ctx.beginPath();
      ctx.roundRect(rect.cx-rect.w/2, rect.cy-rect.h/2, rect.w, rect.h, rect.r);
      ctx.strokeStyle = `rgba(130,205,255,${0.20*k})`;
      ctx.lineWidth = 1; ctx.stroke();
    }

    ctx.globalCompositeOperation = 'lighter';
    for(const p of P){
      const tw = 0.75 + 0.25*Math.sin(t*2.2 + p.pulse);
      const r = p.size*(1+k*0.35)*tw;
      ctx.beginPath(); ctx.arc(p.x,p.y,r,0,Math.PI*2);
      ctx.fillStyle = `hsla(${p.hue},100%,${72+18*tw}%,${0.55+0.4*k})`;
      ctx.fill();
      ctx.beginPath(); ctx.arc(p.x,p.y,r*3.2,0,Math.PI*2);
      ctx.fillStyle = `hsla(${p.hue},100%,65%,${0.05+0.07*glow})`;
      ctx.fill();
    }

    if(glow>0.01){
      for(const pu of pulses){
        pu.u += pu.speed*0.016;
        const segs = 16;
        for(let s=0;s<segs;s++){
          const uu = pu.u - (s*pu.len)/segs;
          const pt = pointAt(uu);
          const a = 1 - s/segs;
          const rr = 1.4 + a*4.0;
          ctx.beginPath(); ctx.arc(pt.x,pt.y,rr,0,Math.PI*2);
          ctx.fillStyle = `hsla(${pu.hue},100%,${62+a*28}%,${a*a*0.85*glow})`;
          ctx.fill();
        }
      }
    }

    ctx.globalCompositeOperation = 'source-over';
    ctx.globalAlpha = 1;

    if(t >= T_TOTAL){ finishIntro(); return; }
    requestAnimationFrame(frame);
  }

  requestAnimationFrame(frame);

  skipBtn.addEventListener('click', finishIntro);
  canvas.addEventListener('click', finishIntro);
  window.addEventListener('keydown', e => {
    if(e.key === 'Escape' || e.key === ' ') finishIntro();
  });
})();

/* =========================================================
   انیمیشن هدر (نقطه‌های متصل متحرک)
========================================================= */
function startHeaderAnim(){
  const hc = document.getElementById('hdrCanvas');
  if(!hc) return;
  const hx = hc.getContext('2d');
  let HW=0, HH=0, dpr=1;
  const dots = [];

  function init(){
    const r = hc.getBoundingClientRect();
    HW = r.width; HH = r.height;
    dpr = Math.min(window.devicePixelRatio||1, 2);
    hc.width = Math.floor(HW*dpr);
    hc.height = Math.floor(HH*dpr);
    hx.setTransform(dpr,0,0,dpr,0,0);

    dots.length = 0;
    const count = Math.max(16, Math.floor(HW/34));
    for(let i=0;i<count;i++){
      dots.push({
        x: Math.random()*HW,
        y: Math.random()*HH,
        vx: (Math.random()<0.5?-1:1)*(0.15+Math.random()*0.45),
        vy: (Math.random()-0.5)*0.12,
        r: 0.9 + Math.random()*1.4,
        hue: 190 + Math.random()*90
      });
    }
  }

  let hStart = performance.now();
  function loop(now){
    const t = (now - hStart)/1000;
    hx.clearRect(0,0,HW,HH);

    for(const d of dots){
      d.x += d.vx; d.y += d.vy;
      if(d.x < -20){ d.x = HW+20; }
      if(d.x > HW+20){ d.x = -20; }
      if(d.y < 0){ d.y = 0; d.vy *= -1; }
      if(d.y > HH){ d.y = HH; d.vy *= -1; }
    }

    const MD = 78, MD2 = MD*MD;
    hx.lineWidth = 0.7;
    for(let i=0;i<dots.length;i++){
      const a = dots[i];
      for(let j=i+1;j<dots.length;j++){
        const b = dots[j];
        const dx=a.x-b.x, dy=a.y-b.y;
        const d2 = dx*dx+dy*dy;
        if(d2>MD2) continue;
        const al = Math.pow(1-Math.sqrt(d2)/MD, 1.6) * 0.42;
        if(al < 0.02) continue;
        hx.strokeStyle = `rgba(96,190,255,${al})`;
        hx.beginPath(); hx.moveTo(a.x,a.y); hx.lineTo(b.x,b.y); hx.stroke();
      }
    }

    hx.globalCompositeOperation = 'lighter';
    for(const d of dots){
      const tw = 0.7 + 0.3*Math.sin(t*2 + d.x*0.02);
      hx.beginPath(); hx.arc(d.x,d.y,d.r*tw,0,Math.PI*2);
      hx.fillStyle = `hsla(${d.hue},100%,72%,0.9)`;
      hx.fill();
      hx.beginPath(); hx.arc(d.x,d.y,d.r*4,0,Math.PI*2);
      hx.fillStyle = `hsla(${d.hue},100%,65%,0.06)`;
      hx.fill();
    }
    hx.globalCompositeOperation = 'source-over';

    requestAnimationFrame(loop);
  }

  init();
  window.addEventListener('resize', init);
  requestAnimationFrame(loop);
}

/* =========================================================
   رندر رابط کاربری
========================================================= */
const stage = document.getElementById('stage');
let hdrRunning = false;

/* --- رندر بلوک --- */
function renderBlock(b){
  switch(b.type){
    case 'heading':
      return `<h3 class="blk-h">${b.text}</h3>`;
    case 'text':
      return `<p class="blk-p">${b.text}</p>`;
    case 'list':
      return `<ul class="blk-list">${b.items.map(i=>`<li>${i}</li>`).join('')}</ul>`;
    case 'formula':
      return `<div class="formula-grid">${b.items.map(f=>`
        <div class="fcard">
          <div class="fname">${f.n}</div>
          <div class="fform">${f.f}</div>
          ${f.note ? `<div class="fnote">${f.note}</div>` : ''}
        </div>`).join('')}</div>`;
    case 'ayah':
      return `<div class="ayah-list">${b.items.map(a=>`
        <div class="ayah-card">
          <div class="ayah-name">${a.name}</div>
          <div class="ayah-ar">${a.ar}</div>
          <div class="ayah-fa">${a.fa}</div>
        </div>`).join('')}</div>`;
    case 'solve':
      return `<div class="solve-wrap">${b.items.map((s,i)=>`
        <details class="solve-card">
          <summary>
            <span class="qnum">${i+1}</span>
            ${s.q}
            <span class="qpage">${s.page}</span>
          </summary>
          <div class="steps">
            ${s.steps.map((st,j)=>`<div class="step"><span class="snum">${j+1}</span>${st}</div>`).join('')}
            <div class="ans">✓ پاسخ نهایی: ${s.ans}</div>
          </div>
        </details>`).join('')}</div>`;
    default: return '';
  }
}

/* --- نمای منو --- */
function renderMenu(){
  const keys = Object.keys(DATA);
  const btns = keys.map((k,i)=>{
    const d = DATA[k];
    return `<button class="btn" data-key="${k}"
              style="--h:${d.hue}; --d:${(i*0.07).toFixed(2)}s">
              ${d.icon} ${d.title}
              <span class="arw">‹</span>
            </button>`;
  }).join('');

  stage.innerHTML = `
    <div class="view menu-view">
      <div class="panel">
        <h1 class="panel-title">کلاس من — انتخاب درس</h1>
        <div class="grid">${btns}</div>
        <div class="foot">
          ساخته شده توسط <b>امیرعلی محمدی</b><br>
          برای مشاهدهٔ هر درس، روی دکمهٔ آن بزنید
        </div>
      </div>
    </div>`;

  stage.scrollTop = 0;

  stage.querySelectorAll('.btn').forEach(btn=>{
    btn.addEventListener('pointermove', e=>{
      const r = btn.getBoundingClientRect();
      btn.style.setProperty('--mx', ((e.clientX-r.left)/r.width*100)+'%');
    });
    btn.addEventListener('click', ()=> openSubject(btn.dataset.key));
  });
}

/* --- نمای درس --- */
function openSubject(key){
  const d = DATA[key];
  if(!d) return;

  const blocks = d.blocks.map(renderBlock).join('');

  stage.innerHTML = `
    <div class="view" style="--h:${d.hue}">
      <div class="backbar">
        <button class="back" id="backBtn">‹ بازگشت به منو</button>
        <span class="crumb">کلاس من / ${d.title}</span>
      </div>
      <div class="panel" style="--h:${d.hue}">
        <div class="d-head">
          <div class="d-icon">${d.icon}</div>
          <div>
            <div class="d-title">${d.title}</div>
            <div class="d-sub">${d.sub}</div>
          </div>
        </div>
        ${blocks}
        <div class="foot">
          ساخته شده توسط <b>امیرعلی محمدی</b>
        </div>
      </div>
    </div>`;

  stage.scrollTop = 0;

  document.getElementById('backBtn').addEventListener('click', renderMenu);
}

/* =========================================================
   شروع
========================================================= */
document.getElementById('app').addEventListener('transitionend', ()=>{}, {once:true});
renderMenu();

/* اگر انیمیشن رد شد، منو نمایش داده شود */
window.addEventListener('load', ()=>{
  setTimeout(()=>{
    const app = document.getElementById('app');
    if(!app.classList.contains('show')){
      // اگر انیمیشن هنوز تمام نشده، منتظر بمان — finishIntro خودش انجام می‌دهد
    }
  }, 100);
});
</script>
