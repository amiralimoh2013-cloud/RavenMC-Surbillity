    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(230px, 1fr));
    gap:clamp(12px, 1.6vw, 20px);
  }

  /* ---------- دکمه‌های معلم‌ها ---------- */
  .btn{
    --h:200;
    position:relative;
    display:block;
    width:100%;
    text-align:right;
    font-family:inherit;
    font-size:clamp(14px, 1.35vw, 18px);
    font-weight:700;
    line-height:1.6;
    color:#e9f6ff;
    padding:clamp(15px, 1.9vw, 22px) 18px;
    padding-inline-start:44px;      /* جا برای نقطه */
    border-radius:22px;
    border:1px solid hsla(var(--h), 90%, 65%, .32);
    background:
      linear-gradient(150deg, hsla(var(--h), 90%, 60%, .12), rgba(255,255,255,.02));
    cursor:pointer;
    overflow:hidden;
    transform:scale(1);
    transition:
      transform .35s cubic-bezier(.2,.9,.3,1.45),
      box-shadow .35s ease,
      border-color .35s ease,
      background .35s ease;
    will-change:transform;
    -webkit-tap-highlight-color:transparent;
  }

  /* نقطه‌ی نورانی داخل هر دکمه */
  .btn::before{
    content:'';
    position:absolute;
    top:50%;
    inset-inline-start:17px;
    width:10px;height:10px;
    margin-top:-5px;
    border-radius:50%;
    background:hsla(var(--h), 95%, 70%, .95);
    box-shadow:0 0 12px 1px hsla(var(--h), 95%, 65%, .9);
    transition:transform .35s cubic-bezier(.2,.9,.3,1.45),
               box-shadow .35s ease,
               background .35s ease;
  }

  /* درخشش عبوری */
  .btn::after{
    content:'';
    position:absolute;
    inset:0;
    border-radius:inherit;
    background:radial-gradient(120px 60px at var(--mx,50%) 50%,
                hsla(var(--h),100%,75%,.28), transparent 70%);
    opacity:0;
    transition:opacity .35s ease;
    pointer-events:none;
  }

  .btn:hover{
    transform:scale(1.09);
    border-color:hsla(var(--h), 95%, 72%, .95);
    background:
      linear-gradient(150deg, hsla(var(--h), 95%, 62%, .28), rgba(255,255,255,.05));
    box-shadow:
      0 0 0 1px hsla(var(--h), 95%, 72%, .35),
      0 14px 38px hsla(var(--h), 90%, 55%, .38),
      0 0 46px hsla(var(--h), 90%, 60%, .28);
    z-index:5;
  }
  .btn:hover::before{
    transform:scale(1.7);
    background:#fff;
    box-shadow:0 0 24px 6px hsla(var(--h), 95%, 70%, .85);
  }
  .btn:hover::after{opacity:1}

  .btn:active{transform:scale(1.02)}
  .btn:focus-visible{
    outline:2px solid hsla(var(--h),95%,72%,.9);
    outline-offset:3px;
  }

  /* ورود پله‌ای دکمه‌ها (با translate تا با hover تداخل نکند) */
  @keyframes fadeUp{
    from{opacity:0; translate:0 22px;}
    to  {opacity:1; translate:0 0;}
  }
  .menu.show .btn{
    animation:fadeUp .65s cubic-bezier(.2,.9,.3,1.3) both;
    animation-delay:var(--d, 0s);
  }

  @media (max-width:520px){
    .panel{border-radius:34px;padding:20px 16px}
    .grid{grid-template-columns:1fr}
    .btn{text-align:center;padding-inline-start:18px}
    .btn::before{display:none}
  }
</style>
