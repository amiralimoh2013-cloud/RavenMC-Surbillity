          ar:'وَمَا أَدْرَاكَ مَا لَيْلَةُ الْقَدْرِ',
          fa:'و تو چه می‌دانی شب قدر چیست؟' },
        { name:'سورهٔ قدر — آیهٔ ۳',
          ar:'لَيْلَةُ الْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ',
          fa:'شب قدر بهتر از هزار ماه است.' },
        { name:'سورهٔ قدر — آیهٔ ۴',
          ar:'تَنَزَّلُ الْمَلَائِكَةُ وَالرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍ',
          fa:'فرشتگان و روح در آن شب به اذن پروردگارشان برای هر امری نازل می‌شوند.' },
        { name:'سورهٔ قدر — آیهٔ ۵',
          ar:'سَلَامٌ هِيَ حَتَّىٰ مَطْلَعِ الْفَجْرِ',
          fa:'آن شب سلام و آرامش است تا طلوع فجر.' }
      ]},

      {type:'heading', text:'سورهٔ فلق'},
      {type:'ayah', items:[
        { name:'سورهٔ فلق — آیهٔ ۱',
          ar:'قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ',
          fa:'بگو: پناه می‌برم به پروردگار سپیده‌دم.' },
        { name:'سورهٔ فلق — آیهٔ ۲',
          ar:'مِن شَرِّ مَا خَلَقَ',
          fa:'از شر آنچه آفریده است.' },
        { name:'سورهٔ فلق — آیهٔ ۳',
          ar:'وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ',
          fa:'و از شر شب تاریک آنگاه که فرا می‌رسد.' },
        { name:'سورهٔ فلق — آیهٔ ۴',
          ar:'وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ',
          fa:'و از شر جادوگران که در گره‌ها می‌دمند.' },
        { name:'سورهٔ فلق — آیهٔ ۵',
          ar:'وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ',
