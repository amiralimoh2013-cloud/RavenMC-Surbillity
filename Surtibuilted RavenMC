      ]},

      {type:'heading', text:'سورهٔ ناس'},
      {type:'ayah', items:[
        { name:'سورهٔ ناس — آیهٔ ۱',
          ar:'قُلْ أَعُوذُ بِرَبِّ النَّاسِ',
          fa:'بگو: پناه می‌برم به پروردگار مردم.' },
        { name:'سورهٔ ناس — آیهٔ ۲',
          ar:'مَلِكِ النَّاسِ',
          fa:'فرمانروای مردم.' },
        { name:'سورهٔ ناس — آیهٔ ۳',
          ar:'إِلَٰهِ النَّاسِ',
          fa:'معبود مردم.' },
        { name:'سورهٔ ناس — آیهٔ ۴',
          ar:'مِن شَرِّ الْوَسْوَاسِ الْخَنَّاسِ',
          fa:'از شر وسوسه‌گر پنهان‌شونده.' },
        { name:'سورهٔ ناس — آیهٔ ۵',
          ar:'الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ',
          fa:'آنکه در سینه‌های مردم وسوسه می‌کند.' },
        { name:'سورهٔ ناس — آیهٔ ۶',
          ar:'مِنَ الْجِنَّةِ وَالنَّاسِ',
          fa:'از جن و از انسان.' }
      ]},

      {type:'heading', text:'سورهٔ عصر'},
      {type:'ayah', items:[
        { name:'سورهٔ عصر — آیهٔ ۱',
          ar:'وَالْعَصْرِ',
          fa:'سوگند به عصر.' },
        { name:'سورهٔ عصر — آیهٔ ۲',
          ar:'إِنَّ الْإِنسَانَ لَفِي خُسْرٍ',
          fa:'همانا انسان در زیان است.' },
        { name:'سورهٔ عصر — آیهٔ ۳',
          ar:'إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ',
          fa:'مگر کسانی که ایمان آوردند و کارهای شایسته کردند و یکدیگر را به حق و صبر سفارش کردند.' }
      ]},

      {type:'heading', text:'سورهٔ انشراح (شرح)'},
      {type:'ayah', items:[
        { name:'سورهٔ انشراح — آیهٔ ۱',
          ar:'أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ',
          fa:'آیا سینه‌ات را برای تو گشاده نکردیم؟' },
        { name:'سورهٔ انشراح — آیهٔ ۲',
          ar:'وَوَضَعْنَا عَنكَ وِزْرَكَ',
          fa:'و بار سنگینت را از تو برداشتیم.' },
        { name:'سورهٔ انشراح — آیهٔ ۳',
          ar:'الَّذِي أَنقَضَ ظَهْرَكَ',
          fa:'آن باری که پشت تو را خم کرده بود.' },
        { name:'سورهٔ انشراح — آیهٔ ۴',
          ar:'وَرَفَعْنَا لَكَ ذِكْرَكَ',
          fa:'و نام تو را بلند کردیم.' },
        { name:'سورهٔ انشراح — آیهٔ ۵',
          ar:'فَإِنَّ مَعَ الْعُسْرِ يُسْرًا',
          fa:'پس همانا با سختی آسانی است.' },
        { name:'سورهٔ انشراح — آیهٔ ۶',
          ar:'إِنَّ مَعَ الْعُسْرِ يُسْرًا',
          fa:'همانا با سختی آسانی است.' },
        { name:'سورهٔ انشراح — آیهٔ ۷',
          ar:'فَإِذَا فَرَغْتَ فَانصَبْ',
          fa:'پس هنگامی که فارغ شدی، به تلاش برخیز.' },
        { name:'سورهٔ انشراح — آیهٔ ۸',
          ar:'وَإِلَىٰ رَبِّكَ فَارْغَبْ',
          fa:'و به سوی پروردگارت روی آور.' }
      ]},

      {type:'heading', text:'سورهٔ ضحی'},
      {type:'ayah', items:[
        { name:'سورهٔ ضحی — آیهٔ ۱',
          ar:'وَالضُّحَىٰ',
          fa:'سوگند به روز روشن.' },
        { name:'سورهٔ ضحی — آیهٔ ۲',
          ar:'وَاللَّيْلِ إِذَا سَجَىٰ',
          fa:'و سوگند به شب آنگاه که آرام می‌گیرد.' },
        { name:'سورهٔ ضحی — آیهٔ ۳',
          ar:'مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ',
          fa:'پروردگارت تو را رها نکرد و خشم نگرفت.' },
        { name:'سورهٔ ضحی — آیهٔ ۴',
          ar:'وَلَلْآخِرَةُ خَيْرٌ لَّكَ مِنَ الْأُولَىٰ',
          fa:'و همانا آخرت برای تو بهتر از دنیاست.' },
        { name:'سورهٔ ضحی — آیهٔ ۵',
          ar:'وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ',
          fa:'و به‌زودی پروردگارت به تو عطا می‌کند تا خشنود شوی.' }
      ]},

      {type:'heading', text:'آیةالکرسی (بقره — آیهٔ ۲۵۵)'},
      {type:'ayah', items:[
        { name:'آیةالکرسی — بخش اول',
          ar:'اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ',
          fa:'خداوند است که هیچ معبودی جز او نیست؛ زنده و پایدار است.' },
        { name:'آیةالکرسی — بخش دوم',
          ar:'لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ',
          fa:'نه خواب سبک او را می‌گیرد و نه خواب سنگین.' },
        { name:'آیةالکرسی — بخش سوم',
          ar:'لَّهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ',
          fa:'آنچه در آسمان‌ها و زمین است از اوست.' },
        { name:'آیةالکرسی — بخش چهارم',
          ar:'مَن ذَا الَّذِي يَشْفَعُ عِندَهُ إِلَّا بِإِذْنِهِ',
          fa:'کیست که نزد او شفاعت کند مگر به اذن او؟' },
        { name:'آیةالکرسی — بخش پنجم',
          ar:'يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ',
          fa:'می‌داند آنچه پیش روی آنان و آنچه پشت سرشان است.' },
        { name:'آیةالکرسی — بخش ششم',
          ar:'وَلَا يُحِيطُونَ بِشَيْءٍ مِّنْ عِلْمِهِ إِلَّا بِمَا شَاءَ',
          fa:'و به چیزی از علم او احاطه ندارند مگر آنچه او بخواهد.' },
        { name:'آیةالکرسی — بخش هفتم',
          ar:'وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ',
          fa:'کرسی او آسمان‌ها و زمین را در برگرفته است.' },
        { name:'آیةالکرسی — بخش هشتم',
          ar:'وَلَا يَئُودُهُ حِفْظُهُمَا وَهُوَ الْعَلِيُّ الْعَظِيمُ',
          fa:'و نگهداری آن دو بر او سنگین نیست و او بلندمرتبه و بزرگ است.' }
      ]},

      {type:'heading', text:'سورهٔ بقره — آیات منتخب'},
      {type:'ayah', items:[
        { name:'بقره — آیهٔ ۱۵۳',
          ar:'يَا أَيُّهَا الَّذِينَ آمَنُوا اسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ ۚ إِنَّ اللَّهَ مَعَ الصَّابِرِينَ',
          fa:'ای کسانی که ایمان آورده‌اید! از صبر و نماز کمک بگیرید؛ همانا خدا با صبرکنندگان است.' },
        { name:'بقره — آیهٔ ۱۸۶',
          ar:'وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ ۖ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ',
          fa:'و هنگامی که بندگانم از من بپرسند، همانا من نزدیکم؛ دعای دعاکننده را هنگامی که مرا بخواند پاسخ می‌دهم.' },
        { name:'بقره — آیهٔ ۲۵۶',
          ar:'لَا إِكْرَاهَ فِي الدِّينِ ۖ قَد تَّبَيَّنَ الرُّشْدُ مِنَ الْغَيِّ',
          fa:'در دین اجباری نیست؛ همانا راه درست از گمراهی روشن شده است.' },
        { name:'بقره — آیهٔ ۲۸۶',
          ar:'لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا',
          fa:'خداوند هیچ‌کس را جز به اندازهٔ توانش تکلیف نمی‌کند.' }
      ]},

      {type:'heading', text:'سورهٔ حجرات — اخلاق اسلامی'},
      {type:'ayah', items:[
        { name:'حجرات — آیهٔ ۱۱',
          ar:'لَا يَسْخَرْ قَوْمٌ مِّن قَوْمٍ عَسَىٰ أَن يَكُونُوا خَيْرًا مِّنْهُمْ',
          fa:'گروهی گروه دیگر را مسخره نکنند، شاید آنان بهتر از آنان باشند.' },
        { name:'حجرات — آیهٔ ۱۲',
          ar:'يَا أَيُّهَا الَّذِينَ آمَنُوا اجْتَنِبُوا كَثِيرًا مِّنَ الظَّنِّ إِنَّ بَعْضَ الظَّنِّ إِثْمٌ',
          fa:'ای مؤمنان! از بسیاری از گمان‌ها بپرهیزید که برخی از گمان‌ها گناه است.' },
        { name:'حجرات — آیهٔ ۱۳',
          ar:'إِنَّ أَكْرَمَكُمْ عِندَ اللَّهِ أَتْقَاكُمْ',
          fa:'همانا گرامی‌ترین شما نزد خدا پرهیزگارترین شماست.' }
      ]},

      {type:'heading', text:'سورهٔ لقمان — پندهای حکیمانه'},
      {type:'ayah', items:[
        { name:'لقمان — آیهٔ ۱۳',
          ar:'يَا بُنَيَّ لَا تُشْرِكْ بِاللَّهِ ۖ إِنَّ الشِّرْكَ لَظُلْمٌ عَظِيمٌ',
          fa:'ای پسرک من! به خدا شرک نورز؛ همانا شرک ستمی بزرگ است.' },
        { name:'لقمان — آیهٔ ۱۷',
          ar:'يَا بُنَيَّ أَقِمِ الصَّلَاةَ وَأْمُرْ بِالْمَعْرُوفِ وَانْهَ عَنِ الْمُنكَرِ وَاصْبِرْ عَلَىٰ مَا أَصَابَكَ',
          fa:'ای پسرک من! نماز را برپا دار و به خوبی فرمان ده و از بدی نهی کن و بر آنچه به تو می‌رسد صبر کن.' },
        { name:'لقمان — آیهٔ ۱۸',
          ar:'وَلَا تُصَعِّرْ خَدَّكَ لِلنَّاسِ وَلَا تَمْشِ فِي الْأَرْضِ مَرَحًا',
          fa:'و روی خود را از مردم برنگردان و در زمین با تکبر راه نرو.' },
        { name:'لقمان — آیهٔ ۱۹',
          ar:'وَاقْصِدْ فِي مَشْيِكَ وَاغْضُضْ مِن صَوْتِكَ',
          fa:'و در راه رفتنت میانه‌رو باش و صدایت را پایین بیاور.' }
      ]},

      {type:'heading', text:'سورهٔ روم — نشانه‌های خدا'},
      {type:'ayah', items:[
        { name:'روم — آیهٔ ۲۱',
          ar:'وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَاجًا لِّتَسْكُنُوا إِلَيْهَا وَجَعَلَ بَيْنَكُم مَّوَدَّةً وَرَحْمَةً',
          fa:'و از نشانه‌های او این است که برای شما از خودتان همسرانی آفرید تا در کنارشان آرام گیرید و میان شما دوستی و مهربانی قرار داد.' },
        { name:'روم — آیهٔ ۲۲',
          ar:'وَمِنْ آيَاتِهِ خَلْقُ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافُ أَلْسِنَتِكُمْ وَأَلْوَانِكُمْ',
          fa:'و از نشانه‌های او آفرینش آسمان‌ها و زمین و تفاوت زبان‌ها و رنگ‌های شماست.' }
      ]},

      {type:'heading', text:'سورهٔ یاسین — آیات منتخب'},
      {type:'ayah', items:[
        { name:'یاسین — آیهٔ ۱ و ۲',
          ar:'يس ۝ وَالْقُرْآنِ الْحَكِيمِ',
          fa:'یاسین. سوگند به قرآن حکیم.' },
        { name:'یاسین — آیهٔ ۳',
          ar:'إِنَّكَ لَمِنَ الْمُرْسَلِينَ',
          fa:'همانا تو از فرستادگان هستی.' },
        { name:'یاسین — آیهٔ ۸۲',
          ar:'إِنَّمَا أَمْرُهُ إِذَا أَرَادَ شَيْئًا أَن يَقُولَ لَهُ كُن فَيَكُونُ',
          fa:'فرمان او چنین است که هرگاه چیزی را بخواهد، به آن می‌گوید: باش! پس می‌شود.' }
      ]},

      {type:'heading', text:'سورهٔ ملک — توحید و قدرت خدا'},
      {type:'ayah', items:[
        { name:'ملک — آیهٔ ۱',
          ar:'تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ',
          fa:'خجسته است آنکه فرمانروایی به دست اوست و او بر هر چیزی تواناست.' },
        { name:'ملک — آیهٔ ۲',
          ar:'الَّذِي خَلَقَ الْمَوْتَ وَالْحَيَاةَ لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًا',
          fa:'آنکه مرگ و زندگی را آفرید تا شما را بیازماید که کدام‌یک نیکوتر عمل می‌کنید.' }
      ]},

      {type:'heading', text:'دعاهای قرآنی'},
      {type:'ayah', items:[
        { name:'دعای هدایت — بقره ۲۰۱',
          ar:'رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ',
          fa:'پروردگارا! در دنیا به ما نیکی عطا کن و در آخرت نیز نیکی و ما را از عذاب آتش نجات ده.' },
        { name:'دعای علم — طه ۱۱۴',
          ar:'رَّبِّ زِدْنِي عِلْمًا',
          fa:'پروردگارا! بر دانش من بیفزای.' },
        { name:'دعای صبر — بقره ۲۵۰',
          ar:'رَبَّنَا أَفْرِغْ عَلَيْنَا صَبْرًا وَثَبِّتْ أَقْدَامَنَا',
          fa:'پروردگارا! بر ما صبر فرو ریز و گام‌هایمان را استوار دار.' },
