<body>

<div id="chat"></div>

<div id="inputArea">
  <input id="userInput" placeholder="Ask me something..." autocomplete="off">
  <button id="sendBtn">Send</button>
</div>

<script>
const chat = document.getElementById('chat');
const input = document.getElementById('userInput');
const sendBtn = document.getElementById('sendBtn');

function addMessage(text, who) {
  const div = document.createElement('div');
  div.className = 'msg ' + who;
  div.textContent = text;
  chat.appendChild(div);
  chat.scrollTop = chat.scrollHeight;
}

function getReply(msg) {
  const text = msg.toLowerCase();

  if (/\b(hello|hi|hey)\b/.test(text)) {
    return 'Hello! How can I help you?';
  }

  if (text.includes('how are you')) {
    return 'I am just code, but I am running fine! How are you?';
  }

  if (text.includes('your name') || text.includes('who are you')) {
    return 'I am Mini AI, your phone chatbot.';
  }

  if (/\btime\b/.test(text)) {
    return 'Time is ' + new Date().toLocaleTimeString();
  }

  if (/\b(date|today)\b/.test(text)) {
    return 'Today is ' + new Date().toLocaleDateString();
  }

  if (/\bhelp\b/.test(text)) {
    return 'Try: hello, how are you, your name, time, date, or math like 2+2.';
  }

  // Simple math
  if (/^[\d+\-*/().\s]+$/.test(msg) && /\d/.test(msg)) {
    try {
      const result = Function('"use strict"; return (' + msg + ')')();
      return 'Answer: ' + result;
    } catch (e) {
      return 'I could not calculate that.';
    }
  }

  const fallbacks = [
    'Interesting. Tell me more.',
    'I do not know that yet, but I am learning.',
    'Can you ask in another way?',
    'That is a good question. What do you think?',
    'I am a simple AI, so I may not know everything.'
  ];

  return fallbacks[Math.floor(Math.random() * fallbacks.length)];
}

function sendMessage() {
  const msg = input.value.trim();
  if (!msg) return;

  addMessage(msg, 'user');
  input.value = '';

  setTimeout(() => {
    addMessage(getReply(msg), 'ai');
  }, 300);
}

sendBtn.addEventListener('click', sendMessage);

input.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') sendMessage();
});

addMessage('Hi! I am your Mini AI. Ask me something.', 'ai');
</script>

