<script>
(() => {
  "use strict";

  /* ================= تنظیمات زمان‌بندی (کل: ۲۰ ثانیه) ================= */
  const T_CONVERGE_START = 5.0;    // شروع جمع‌شدن نقطه‌ها
  const T_CONVERGE_END   = 13.0;   // پایان جمع‌شدن (تشکیل مستطیل)
  const T_FADE_START     = 18.2;   // شروع محو شدن کانواس
  const T_FADE_END       = 19.6;   // پایان محو شدن
  const T_MENU           = 18.4;   // نمایش منو (میلی‌ثانیه پایین)
  const T_TOTAL          = 20.0;

  const menu = document.getElementById('menu');
  const canvas = document.getElementById('intro');
  const ctx = canvas.getContext('2d');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduceMotion) {
    canvas.style.display = 'none';
    menu.classList.add('show');
    return;
  }

  /* ================= ابزارها ================= */
  const smoothstep = (a, b, x) => {
    const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
    return t * t * (3 - 2 * t);
  };
  const rand = (a, b) => a + Math.random() * (b - a);

  /* ================= اندازه‌ها ================= */
  let W = 0, H = 0, DPR = 1;
  const rect = { w: 0, h: 0, r: 0, cx: 0, cy: 0 };

  const N = window.innerWidth < 700 ? 96 : 150;   // تعداد نقطه‌ها
  const P = [];

  function computeRect() {
    rect.w = Math.min(W * 0.88, 1060);
    rect.h = Math.min(H * 0.74, 640);
    rect.r = Math.min(84, rect.h * 0.24);
    rect.cx = W / 2;
    rect.cy = H / 2;
  }

  /* نقطه روی محیط مستطیلِ گوشه‌گرد — u بین ۰ و ۱ */
  function pointAt(u) {
    u = ((u % 1) + 1) % 1;
    const w = rect.w, h = rect.h, R = rect.r;
    const x0 = rect.cx - w / 2, y0 = rect.cy - h / 2;
    const top  = w - 2 * R;
    const side = h - 2 * R;
    const arc  = Math.PI * R / 2;
    const total = 2 * top + 2 * side + 4 * arc;
    let d = u * total;

    if (d < top)  return { x: x0 + R + d, y: y0 };
    d -= top;
    if (d < arc) { const a = -Math.PI/2 + (d/arc)*(Math.PI/2);
                   return { x: x0 + w - R + R*Math.cos(a), y: y0 + R + R*Math.sin(a) }; }
    d -= arc;
    if (d < side) return { x: x0 + w, y: y0 + R + d };
    d -= side;
    if (d < arc) { const a = (d/arc)*(Math.PI/2);
                   return { x: x0 + w - R + R*Math.cos(a), y: y0 + h - R + R*Math.sin(a) }; }
    d -= arc;
    if (d < top)  return { x: x0 + w - R - d, y: y0 + h };
    d -= top;
    if (d < arc) { const a = Math.PI/2 + (d/arc)*(Math.PI/2);
                   return { x: x0 + R + R*Math.cos(a), y: y0 + h - R + R*Math.sin(a) }; }
    d -= arc;
    if (d < side) return { x: x0, y: y0 + h - R - d };
    d -= side;
    const a = Math.PI + (d/arc)*(Math.PI/2);
    return { x: x0 + R + R*Math.cos(a), y: y0 + R + R*Math.sin(a) };
  }

  function assignTargets() {
    for (let i = 0; i < N; i++) {
      const p = pointAt(i / N);
      P[i].tx = p.x;
      P[i].ty = p.y;
    }
  }

  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth;
    H = window.innerHeight;
    canvas.width  = Math.floor(W * DPR);
    canvas.height = Math.floor(H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    computeRect();
    assignTargets();
  }

  /* ================= ساخت ذره‌ها ================= */
  for (let i = 0; i < N; i++) {
    P.push({
      fx: Math.random() * window.innerWidth,
      fy: Math.random() * window.innerHeight,
      vx: rand(-0.35, 0.35),
      vy: rand(-0.35, 0.35),
      x: 0, y: 0,
      tx: 0, ty: 0,
      size: rand(1.2, 2.6),
      pulse: Math.random() * Math.PI * 2,
      hue: Math.random() < 0.18 ? 265 : 198 + rand(-14, 18)
    });
  }

  window.addEventListener('resize', resize);
  resize();
  for (const p of P) { p.x = p.fx; p.y = p.fy; }

  /* =================脉冲های گردشی ================= */
  const pulses = [
    { u: 0.00,  speed:  0.048, hue: 198, len: 0.030 },
    { u: 0.42,  speed: -0.036, hue: 268, len: 0.024 },
    { u: 0.73,  speed:  0.062, hue: 170, len: 0.020 }
  ];

  /* ================= حلقه‌ی انیمیشن ================= */
  const start = performance.now();
  let rafId = null;

  function frame(now) {
    const t = (now - start) / 1000;

    /* --- ضریب‌ها --- */
    const fadeIn  = smoothstep(0, 0.9, t);
    const fadeOut = 1 - smoothstep(T_FADE_START, T_FADE_END, t);
    const alpha   = fadeIn * fadeOut;

    const k = smoothstep(T_CONVERGE_START, T_CONVERGE_END, t); // جمع‌شدن
    const glow = smoothstep(T_CONVERGE_END, T_CONVERGE_END + 2.5, t);

    ctx.clearRect(0, 0, W, H);

    if (alpha <= 0.001) {
      if (t >= T_TOTAL) { canvas.style.display = 'none'; return; }
      rafId = requestAnimationFrame(frame);
      return;
    }

    ctx.globalAlpha = alpha;

    /* --- حرکت آزاد ذره‌ها --- */
    for (const p of P) {
      p.fx += p.vx;
      p.fy += p.vy;
      if (p.fx < 0 || p.fx > W) { p.vx *= -1; p.fx = Math.max(0, Math.min(W, p.fx)); }
      if (p.fy < 0 || p.fy > H) { p.vy *= -1; p.fy = Math.max(0, Math.min(H, p.fy)); }

      p.x = p.fx + (p.tx - p.fx) * k;
      p.y = p.fy + (p.ty - p.fy) * k;
    }

    /* --- خطوط ارتباطی --- */
    const maxD = 132 - 62 * k;
    const maxD2 = maxD * maxD;
    ctx.lineWidth = 0.65 + k * 0.55;

    for (let i = 0; i < N; i++) {
      const a = P[i];
      for (let j = i + 1; j < N; j++) {
        const b = P[j];
        const dx = a.x - b.x;
        const dy = a.y - b.y;
        const d2 = dx * dx + dy * dy;
        if (d2 > maxD2) continue;

        const d = Math.sqrt(d2);
        let al = Math.pow(1 - d / maxD, 1.7) * 0.55;
        al *= (0.55 + 0.45 * k);
        if (al < 0.012) continue;

        ctx.strokeStyle = `rgba(96, 190, 255, ${al})`;
        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
      }
    }

    /* --- راهنمای کادر مستطیل --- */
    if (k > 0.02 && typeof ctx.roundRect === 'function') {
      ctx.beginPath();
      ctx.roundRect(
        rect.cx - rect.w / 2,
        rect.cy - rect.h / 2,
        rect.w, rect.h, rect.r
      );
      ctx.strokeStyle = `rgba(130, 205, 255, ${0.20 * k})`;
      ctx.lineWidth = 1;
      ctx.stroke();
    }

    /* --- نقاط نورانی --- */
    ctx.globalCompositeOperation = 'lighter';

    for (const p of P) {
      const tw = 0.75 + 0.25 * Math.sin(t * 2.2 + p.pulse);
      const r = p.size * (1 + k * 0.35) * tw;

      ctx.beginPath();
      ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
      ctx.fillStyle = `hsla(${p.hue}, 100%, ${72 + 18 * tw}%, ${0.55 + 0.4 * k})`;
      ctx.fill();

      // هاله‌ی ملایم
      ctx.beginPath();
      ctx.arc(p.x, p.y, r * 3.2, 0, Math.PI * 2);
      ctx.fillStyle = `hsla(${p.hue}, 100%, 65%, ${0.05 + 0.07 * glow})`;
      ctx.fill();
    }

    /* --- پالس‌های گردشی روی مستطیل --- */
    if (glow > 0.01) {
      for (const pu of pulses) {
        pu.u += pu.speed * 0.016;
        const segs = 16;
        for (let s = 0; s < segs; s++) {
          const uu = pu.u - (s * pu.len) / segs;
          const pt = pointAt(uu);
          const a = (1 - s / segs);
          const rr = 1.4 + a * 4.0;

          ctx.beginPath();
          ctx.arc(pt.x, pt.y, rr, 0, Math.PI * 2);
          ctx.fillStyle = `hsla(${pu.hue}, 100%, ${62 + a * 28}%, ${a * a * 0.85 * glow})`;
          ctx.fill();
        }
      }
    }

    ctx.globalCompositeOperation = 'source-over';
    ctx.globalAlpha = 1;

    if (t < T_TOTAL) {
      rafId = requestAnimationFrame(frame);
    } else {
      canvas.style.display = 'none';
    }
  }

  rafId = requestAnimationFrame(frame);

  /* ================= نمایش منو ================= */
  setTimeout(() => menu.classList.add('show'), T_MENU * 1000);

  /* ================= درخشش دنبال موس ================= */
  document.querySelectorAll('.btn').forEach(btn => {
    btn.addEventListener('pointermove', e => {
      const r = btn.getBoundingClientRect();
      btn.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%');
    });
  });

})();
</script>
</body>
